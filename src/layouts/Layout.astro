---
interface Props {
  title: string;
  minimalHeader?: boolean;
  headerLabel?: string;
  isAdvertorial?: boolean;
  disableLogoLink?: boolean;
}

const { 
  title, 
  minimalHeader = false, 
  headerLabel, 
  isAdvertorial = false,
  disableLogoLink = isAdvertorial // If advertorial, logo is not clickable by default
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="overflow-x-hidden w-full">
  <head>
    <meta name="robots" content="noindex, nofollow" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-W4vggGVLlXBe6G_5MU7Ph.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <!-- TAILWIND CSS & BRAND CONFIGURATION -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              offwhite: '#F9F9F6',
              brandGold: '#C5A059',
              brandGoldHover: '#B28E46',
              brandNavy: '#07182D',
              brandNavyHover: '#0B223D',
              brandDark: '#121212',
              brandSlate: '#2A2E33',
              brandMuted: '#666666',
              brandBorder: '#E5E4DF'
            },
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
              sans: ['"Plus Jakarta Sans"', 'sans-serif']
            }
          }
        }
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body data-page-type={isAdvertorial ? "advertorial" : "vault"} class="bg-offwhite text-brandDark font-sans antialiased min-h-screen flex flex-col justify-between overflow-x-hidden w-full selection:bg-brandGold selection:text-white">
    
    <!-- TOP BLUE BANNER (ALWAYS VISIBLE) -->
    <div class="bg-brandNavy text-offwhite text-[9px] sm:text-[10px] font-bold tracking-[0.15em] sm:tracking-[0.2em] uppercase py-2 px-4 text-center border-b border-brandGold/30 truncate">
      SOUTHERN EUROPE MARKET INTELLIGENCE UNIT • Q3 2026 SPECIAL BRIEFING AVAILABLE
    </div>

    <!-- MAIN HEADER -->
    <header class="border-b border-brandBorder bg-offwhite sticky top-0 z-40 w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 h-16 sm:h-20 flex items-center justify-between gap-3">
        
        <!-- LOGO (CLICKABLE OR STATIC BASED ON PROPS) -->
        {disableLogoLink ? (
          <div class="flex items-center gap-2.5 sm:gap-3 group shrink-0 select-none">
            <svg 
              class="w-8 h-8 sm:w-10 sm:h-10 text-brandGold shrink-0" 
              viewBox="0 0 100 100" 
              fill="none" 
              stroke="currentColor"
            >
              <circle cx="50" cy="50" r="47" stroke-width="1.5"/>
              <ellipse cx="50" cy="50" rx="21" ry="47" stroke-width="1.2"/>
              <ellipse cx="50" cy="50" rx="47" ry="21" stroke-width="1.2"/>
              <path d="M50 10 L54 38 L82 22 L62 46 L90 50 L62 54 L82 78 L54 62 L50 90 L46 62 L18 78 L38 54 L10 50 L38 46 L18 22 L46 38 Z" fill="#C5A059" stroke="none"/>
              <circle cx="50" cy="50" r="2.5" fill="#F9F9F6"/>
            </svg>

            <div class="flex flex-col justify-center">
              <span class="font-serif text-lg sm:text-[22px] font-bold tracking-[0.05em] text-brandDark uppercase leading-none">
                COSTA LEDGER
              </span>
              <span class="text-[7.5px] sm:text-[8px] tracking-[0.05em] text-brandGold uppercase font-bold leading-none mt-1 hidden sm:block">
                INTELLIGENCE FOR BETTER DECISIONS
              </span>
            </div>
          </div>
        ) : (
          <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
            <svg 
              class="w-8 h-8 sm:w-10 sm:h-10 text-brandGold shrink-0 transition-transform duration-500 group-hover:rotate-45" 
              viewBox="0 0 100 100" 
              fill="none" 
              stroke="currentColor"
            >
              <circle cx="50" cy="50" r="47" stroke-width="1.5"/>
              <ellipse cx="50" cy="50" rx="21" ry="47" stroke-width="1.2"/>
              <ellipse cx="50" cy="50" rx="47" ry="21" stroke-width="1.2"/>
              <path d="M50 10 L54 38 L82 22 L62 46 L90 50 L62 54 L82 78 L54 62 L50 90 L46 62 L18 78 L38 54 L10 50 L38 46 L18 22 L46 38 Z" fill="#C5A059" stroke="none"/>
              <circle cx="50" cy="50" r="2.5" fill="#F9F9F6"/>
            </svg>

            <div class="flex flex-col justify-center">
              <span class="font-serif text-lg sm:text-[22px] font-bold tracking-[0.05em] text-brandDark uppercase leading-none">
                COSTA LEDGER
              </span>
              <span class="text-[7.5px] sm:text-[8px] tracking-[0.05em] text-brandGold uppercase font-bold leading-none mt-1 hidden sm:block">
                INTELLIGENCE FOR BETTER DECISIONS
              </span>
            </div>
          </a>
        )}

        {minimalHeader ? (
          <span class="text-[10px] sm:text-xs font-bold tracking-[0.15em] text-brandMuted uppercase">
            {headerLabel || 'PRIVATE SUBSCRIBER PORTAL'}
          </span>
        ) : (
          <>
            <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8 text-[11px] font-bold tracking-[0.12em] uppercase shrink-0">
              <a href="/categories" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
                ALL INTELLIGENCE
              </a>
              <a href="/categories?pillar=PROPERTY%20%26%20CAPITAL" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
                PROPERTY & CAPITAL
              </a>
              <a href="/categories?pillar=LEGAL,%20TAX%20%26%20RESIDENCY" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
                LEGAL, TAX & RESIDENCY
              </a>
              <a href="/categories?pillar=LIFESTYLE%20%26%20RELOCATION" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
                LIFESTYLE & RELOCATION
              </a>
            </nav>

            <div class="flex items-center gap-2.5 sm:gap-4 shrink-0">
              <a href="/join" class="bg-brandGold hover:bg-brandGoldHover text-white text-[10px] sm:text-[11px] uppercase font-bold tracking-wider px-3 py-2 sm:px-5 sm:py-2.5 transition-all shadow-sm whitespace-nowrap">
                <span class="sm:hidden">JOIN</span>
                <span class="hidden sm:inline">JOIN THE BRIEFING</span>
              </a>

              <button 
                id="mobile-menu-btn" 
                aria-label="Toggle Navigation Menu"
                class="lg:hidden p-2 text-brandDark hover:text-brandGold transition-colors cursor-pointer"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
              </button>
            </div>
          </>
        )}

      </div>
    </header>

    {!minimalHeader && (
      <div id="mobile-menu-drawer" class="fixed inset-0 bg-brandNavy/95 backdrop-blur-md z-50 hidden flex-col justify-between p-8 text-white font-sans transition-all">
        <div class="flex items-center justify-between border-b border-slate-700 pb-6">
          <div class="flex flex-col">
            <span class="font-serif text-xl font-bold tracking-wider text-white uppercase">COSTA LEDGER</span>
            <span class="text-[8px] tracking-widest text-brandGold uppercase font-bold mt-0.5">NAVIGATION MENU</span>
          </div>
          <button id="close-mobile-menu" class="text-slate-400 hover:text-white p-2 text-2xl font-bold cursor-pointer">
            ✕
          </button>
        </div>

        <nav class="flex flex-col space-y-6 my-auto text-sm font-bold tracking-[0.15em] uppercase">
          <a href="/categories" class="mobile-nav-link text-slate-200 hover:text-brandGold border-b border-slate-800 pb-3 transition-colors">
            ALL INTELLIGENCE
          </a>
          <a href="/categories?pillar=PROPERTY%20%26%20CAPITAL" class="mobile-nav-link text-slate-200 hover:text-brandGold border-b border-slate-800 pb-3 transition-colors">
            PROPERTY & CAPITAL
          </a>
          <a href="/categories?pillar=LEGAL,%20TAX%20%26%20RESIDENCY" class="mobile-nav-link text-slate-200 hover:text-brandGold border-b border-slate-800 pb-3 transition-colors">
            LEGAL, TAX & RESIDENCY
          </a>
          <a href="/categories?pillar=LIFESTYLE%20%26%20RELOCATION" class="mobile-nav-link text-slate-200 hover:text-brandGold border-b border-slate-800 pb-3 transition-colors">
            LIFESTYLE & RELOCATION
          </a>
        </nav>

        <div class="pt-6 border-t border-slate-800 space-y-4">
          <a href="/join" class="block text-center bg-brandGold hover:bg-brandGoldHover text-[#07182D] text-xs uppercase font-bold tracking-widest py-3.5 transition-colors">
            JOIN THE BRIEFING
          </a>
          <p class="text-[9px] text-slate-400 text-center uppercase tracking-widest">
            © 2026 COSTA LEDGER • PRIVATE RESEARCH UNIT
          </p>
        </div>
      </div>
    )}

    <slot />

    <!-- FOOTER (ALL LINKS OPEN IN NEW TAB) -->
    <footer class="bg-[#0B1528] text-white py-5 border-t border-slate-800 font-sans w-full overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] tracking-wider uppercase font-semibold">
        <div class="flex items-center gap-2 text-slate-300 whitespace-nowrap">
          <span class="font-serif font-bold text-white text-xs tracking-wider">COSTA LEDGER</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-400 font-normal">Southern Europe Intelligence</span>
        </div>

        <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-2.5 gap-y-1.5 text-slate-400 text-center">
          <a href="/privacy" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A059] transition-colors whitespace-nowrap">Privacy Policy</a>
          <span class="text-slate-700">•</span>
          <a href="/terms" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A059] transition-colors whitespace-nowrap">Terms of Service</a>
          <span class="text-slate-700">•</span>
          <a href="/disclosures" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A059] transition-colors whitespace-nowrap">Disclosures & Disclaimers</a>
          <span class="text-slate-700">•</span>
          <a href="/cookies" target="_blank" rel="noopener noreferrer" class="hover:text-[#C5A059] transition-colors whitespace-nowrap">Cookie Policy</a>
          <span class="text-slate-700">•</span>
          <span class="text-slate-300 font-normal whitespace-nowrap">© 2026 COSTA LEDGER</span>
        </div>
      </div>
    </footer>

    {!minimalHeader && (
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const menuBtn = document.getElementById('mobile-menu-btn');
          const closeBtn = document.getElementById('close-mobile-menu');
          const drawer = document.getElementById('mobile-menu-drawer');
          const navLinks = document.querySelectorAll('.mobile-nav-link');

          function toggleMenu() {
            if (drawer) {
              drawer.classList.toggle('hidden');
              drawer.classList.toggle('flex');
            }
          }

          if (menuBtn) menuBtn.addEventListener('click', toggleMenu);
          if (closeBtn) closeBtn.addEventListener('click', toggleMenu);

          navLinks.forEach(link => {
            link.addEventListener('click', () => {
              if (drawer && !drawer.classList.contains('hidden')) {
                toggleMenu();
              }
            });
          });
        });
      </script>
    )}

    <!-- GLOBAL SCRIPT: CTA CLICK EVENT DELEGATION (VAULT VS ADVERTORIAL) -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;

        const href = link.getAttribute('href');
        
        if (href && (href === '/join' || href === '/report' || href === '/join/' || href === '/report/')) {
          if (typeof window.plausible === 'function') {
            const pageType = document.body.dataset.pageType || 'vault';
            const eventName = pageType === 'advertorial' ? 'CTAClickAdvertorial' : 'CTAClickVault';

            window.plausible(eventName, { 
              props: { 
                target_page: href,
                page_path: window.location.pathname 
              } 
            });
          }
        }
      });
    </script>
    <!-- GLOBAL SCRIPT: CTA CLICK EVENT DELEGATION & SOURCE AUTO-APPEND -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const pageType = document.body.dataset.pageType;
        
        if (pageType === 'advertorial') {
          const currentPath = window.location.pathname.replace(/\/$/, ''); 
          
          // 1. Buscamos TODOS los enlaces que lleven a páginas de conversión
          //    (ya sea por ruta o porque tienen el atributo data-track="cta")
          const ctaLinks = document.querySelectorAll('a[href^="/special/apply"], a[href^="/join"], a[href^="/report"], a[data-track="cta"]');
          
          ctaLinks.forEach(link => {
            try {
              const url = new URL(link.href, window.location.origin); // Añadido origin para evitar errores en links relativos
              // Solo añadimos el parámetro si no es un link externo
              if (url.origin === window.location.origin) {
                url.searchParams.set('src', currentPath); 
                link.href = url.pathname + url.search; // Mantener como ruta relativa si es posible
              }
            } catch(e) {
              console.warn("Could not parse CTA link URL");
            }
          });
        }
      });

      // 2. Track clicks in Plausible
      document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (!link) return;

        const href = link.getAttribute('href') || '';
        
        // Detecta si es un CTA evaluando si la URL contiene palabras clave de conversión O si tiene el atributo de tracking
        const isCtaLink = href.includes('/join') || 
                          href.includes('/report') || 
                          href.includes('/special/apply') || 
                          link.hasAttribute('data-track', 'cta');
        
        if (isCtaLink) {
          if (typeof window.plausible === 'function') {
            const pageType = document.body.dataset.pageType || 'vault';
            const eventName = pageType === 'advertorial' ? 'CTAClickAdvertorial' : 'CTAClickVault';

            window.plausible(eventName, { 
              props: { 
                target_page: href.split('?')[0], 
                page_path: window.location.pathname 
              } 
            });
          }
        }
      });
    </script>
  </body>
</html>
  </body>
</html>