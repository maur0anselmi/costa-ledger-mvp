---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="robots" content="noindex, nofollow" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />

    <!-- TAILWIND CSS & BRAND CONFIGURATION -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              offwhite: '#F9F9F6',
              brandGold: '#C5A059',
              brandGoldHover: '#B28E46',
              brandNavy: '#07182D',
              brandNavyHover: '#0B223D',
              brandDark: '#121212',
              brandSlate: '#2A2E33',
              brandMuted: '#666666',
              brandBorder: '#E5E4DF'
            },
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
              sans: ['"Plus Jakarta Sans"', 'sans-serif']
            }
          }
        }
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-offwhite text-brandDark font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-brandGold selection:text-white">
    
    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-brandNavy text-offwhite text-[9px] sm:text-[10px] font-bold tracking-[0.15em] sm:tracking-[0.2em] uppercase py-2.5 px-4 text-center border-b border-brandGold/30 truncate">
      SOUTHERN EUROPE MARKET INTELLIGENCE UNIT • Q3 2026 SPECIAL BRIEFING AVAILABLE
    </div>

    <!-- MAIN HEADER -->
    <header class="border-b border-brandBorder bg-offwhite sticky top-0 z-40 w-full overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 h-16 sm:h-20 md:h-24 flex items-center justify-between gap-2 sm:gap-4">
        
        <!-- LOGO (SIN ESTILOS INLINE Y CON LEMA OCULTO EN MOBILE) -->
        <a href="/" class="flex items-center gap-2.5 sm:gap-3.5 group shrink-0">
          <svg 
            class="w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 text-brandGold shrink-0 transition-transform duration-500 group-hover:rotate-45" 
            viewBox="0 0 100 100" 
            fill="none" 
            stroke="currentColor"
          >
            <circle cx="50" cy="50" r="47" stroke-width="1.5"/>
            <ellipse cx="50" cy="50" rx="21" ry="47" stroke-width="1.2"/>
            <ellipse cx="50" cy="50" rx="47" ry="21" stroke-width="1.2"/>
            <path d="M50 10 L54 38 L82 22 L62 46 L90 50 L62 54 L82 78 L54 62 L50 90 L46 62 L18 78 L38 54 L10 50 L38 46 L18 22 L46 38 Z" fill="#C5A059" stroke="none"/>
            <circle cx="50" cy="50" r="2.5" fill="#F9F9F6"/>
          </svg>

          <div class="flex flex-col justify-center">
            <span class="font-serif text-lg sm:text-[22px] md:text-[25px] font-bold tracking-[0.06em] text-brandDark uppercase leading-none">
              COSTA LEDGER
            </span>
            <span class="text-[8px] tracking-[0.06em] text-brandGold uppercase font-bold leading-none mt-1 hidden sm:block">
              INTELLIGENCE FOR BETTER DECISIONS
            </span>
          </div>
        </a>

        <!-- NAV LINKS (DESKTOP ONLY) -->
        <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8 text-xs font-bold tracking-[0.15em] uppercase shrink-0">
          <a href="/categories" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
            ALL INTELLIGENCE
          </a>
          <a href="/categories?pillar=PROPERTY%20%26%20CAPITAL" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
            PROPERTY & CAPITAL
          </a>
          <a href="/categories?pillar=LEGAL,%20TAX%20%26%20RESIDENCY" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
            LEGAL, TAX & RESIDENCY
          </a>
          <a href="/categories?pillar=LIFESTYLE%20%26%20RELOCATION" class="text-brandDark hover:text-brandGold transition-colors whitespace-nowrap">
            LIFESTYLE & RELOCATION
          </a>
        </nav>

        <!-- CTA BUTTON -->
        <a href="/join" class="bg-brandGold hover:bg-brandGoldHover text-white text-[10px] sm:text-xs uppercase font-bold tracking-wider sm:tracking-widest px-3 py-2 sm:px-6 sm:py-3.5 transition-all shadow-sm shrink-0 whitespace-nowrap">
          <span class="sm:hidden">JOIN BRIEFING</span>
          <span class="hidden sm:inline">JOIN THE BRIEFING</span>
        </a>

      </div>
    </header>

    <slot />

    <!-- SINGLE-LINE EXECUTIVE FOOTER BAR -->
    <footer class="bg-[#0B1528] text-white py-5 border-t border-slate-800 font-sans">
      <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] tracking-wider uppercase font-semibold">
        
        <!-- LEFT: BRAND & SHORT SLOGAN -->
        <div class="flex items-center gap-2 text-slate-300 whitespace-nowrap">
          <span class="font-serif font-bold text-white text-xs tracking-wider">COSTA LEDGER</span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-400 font-normal">Southern Europe Intelligence</span>
        </div>

        <!-- RIGHT: INLINE LEGAL LINKS & COPYRIGHT -->
        <div class="flex items-center gap-2.5 text-slate-400 whitespace-nowrap">
          <a href="/privacy" class="hover:text-[#C5A059] transition-colors">Privacy Policy</a>
          <span class="text-slate-700">•</span>
          <a href="/terms" class="hover:text-[#C5A059] transition-colors">Terms of Service</a>
          <span class="text-slate-700">•</span>
          <a href="/disclosures" class="hover:text-[#C5A059] transition-colors">Disclosures & Disclaimers</a>
          <span class="text-slate-700">•</span>
          <a href="/cookies" class="hover:text-[#C5A059] transition-colors">Cookie Policy</a>
          <span class="text-slate-700">•</span>
          <span class="text-slate-300 font-normal">© 2026 COSTA LEDGER</span>
        </div>

      </div>
    </footer>

  </body>
</html>