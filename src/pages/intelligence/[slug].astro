---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const dossiers = await getCollection('intelligence');
  return dossiers.map(dossier => ({
    params: { slug: dossier.id },
    props: { dossier },
  }));
}

const { dossier } = Astro.props;
const { Content } = await render(dossier);

// Ensure metadata values are structured as iterable arrays
const regionsList = Array.isArray(dossier.data.region) 
  ? dossier.data.region 
  : [dossier.data.region];

const pillarsList = Array.isArray(dossier.data.pillar) 
  ? dossier.data.pillar 
  : [dossier.data.pillar];

const subcategoriesList = Array.isArray(dossier.data.subcategory) 
  ? dossier.data.subcategory 
  : [dossier.data.subcategory];

// LOGIC FOR RELATED DOSSIERS
const allDossiers = await getCollection('intelligence');
const relatedDossiers = allDossiers
  .filter(d => 
    d.id !== dossier.id && // Excluir la nota actual
    d.data.pillar.some(p => pillarsList.includes(p)) // Que compartan al menos un Pilar
  )
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()) // Más recientes primero
  .slice(0, 2); // Tomar solo 2
---

<Layout title={`${dossier.data.title} - Costa Ledger`}>
  <main class="max-w-4xl mx-auto px-6 lg:px-12 pt-8 pb-16 flex-grow w-full">
    
    <!-- BACK NAVIGATION (SMART BUTTON) -->
    <div class="mb-8">
      <a id="back-btn" href="/categories" class="inline-flex items-center text-[10px] font-bold text-[#666666] hover:text-[#C5A059] uppercase tracking-[0.2em] transition-colors">
        <span class="mr-2 text-sm">←</span> BACK TO VAULT
      </a>
    </div>

    <!-- INTERACTIVE BREADCRUMB METADATA -->
    <div class="flex flex-wrap items-center gap-2 mb-6 text-xs">
      <span class="bg-[#C5A059] text-[#07182D] text-[9px] font-bold tracking-widest uppercase px-2.5 py-1 mr-2">
        {dossier.data.badgeType}
      </span>

      <!-- CLICKABLE REGIONAL TAGS -->
      <span class="font-bold text-[#07182D] uppercase tracking-wider flex items-center gap-1">
        {regionsList.map((region, index) => (
          <>
            <a 
              href={`/categories?region=${encodeURIComponent(region)}`}
              class="hover:text-[#C5A059] transition-colors hover:underline"
            >
              {region}
            </a>
            {index < regionsList.length - 1 && <span class="text-[#666666] font-normal mx-0.5">/</span>}
          </>
        ))}
      </span>

      <span class="text-[#666666] font-mono">•</span>

      <!-- CLICKABLE PILLAR & SUBCATEGORY TAGS -->
      <span class="font-semibold text-[#666666] uppercase tracking-wider flex items-center gap-1">
        {subcategoriesList.map((sub, index) => (
          <>
            <a 
              href={`/categories?sub=${encodeURIComponent(sub)}`}
              class="hover:text-[#C5A059] transition-colors hover:underline"
            >
              {sub}
            </a>
            {index < subcategoriesList.length - 1 && <span class="text-[#666666] font-normal mx-0.5">/</span>}
          </>
        ))}
      </span>
    </div>

    <h1 class="font-serif text-3xl md:text-5xl font-bold text-[#121212] mb-6 leading-tight">
      {dossier.data.title}
    </h1>

    <p class="text-base md:text-lg text-[#2A2E33] leading-relaxed mb-8 italic border-l-2 border-[#C5A059] pl-4">
      {dossier.data.summary}
    </p>

    <div class="flex items-center justify-between border-y border-[#E5E4DF] py-4 mb-8 text-xs text-[#666666]">
      <span>Published: {dossier.data.publishedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <span>{dossier.data.readTime}</span>
    </div>

    <!-- FEATURED DOSSIER IMAGE BLOCK -->
    {dossier.data.image && (
      <figure class="my-8">
        <div class="overflow-hidden border border-[#E5E4DF] bg-[#F4F3EF]">
          <img 
            src={dossier.data.image} 
            alt={dossier.data.title}
            class="w-full h-[320px] md:h-[480px] object-cover"
            onerror="this.parentElement.style.display='none';"
          />
        </div>
        {dossier.data.imageCaption && (
          <figcaption class="flex justify-between items-center text-[11px] text-[#666666] mt-2 px-1 border-b border-[#E5E4DF] pb-2 font-mono">
            <span>{dossier.data.imageCaption}</span>
          </figcaption>
        )}
      </figure>
    )}

    <!-- DOSSIER BODY CONTENT -->
    <div class="prose max-w-none text-sm text-[#2A2E33] leading-relaxed space-y-4">
      <Content />
    </div>

    <!-- GENERAL VAULT ARTICLE CLOSING CTA -->
    <div class="my-16 p-8 md:p-10 bg-[#0B1528] rounded-none border border-slate-800 text-center text-white font-sans">
      <span class="block text-[#C5A059] text-xs font-semibold tracking-widest uppercase mb-3">
        COSTA LEDGER BRIEFING
      </span>
      <h3 class="font-serif text-2xl md:text-3xl text-white font-normal leading-tight mb-4 max-w-2xl mx-auto">
        Information is Abundant. Trusted Judgement is Scarce.
      </h3>
      <p class="text-slate-300 text-sm leading-relaxed max-w-xl mx-auto mb-8 font-light">
        Unfiltered data, cross-border tax updates, and verified capital insights tailored for international founders, family offices, and investors.
      </p>
      <div>
        <a href="/join" class="inline-block bg-[#C5A059] hover:bg-[#B08C46] text-[#07182D] font-semibold text-xs uppercase tracking-wider px-8 py-3.5 transition-colors duration-200">
          JOIN THE BRIEFING
        </a>
      </div>
    </div>

    <!-- DYNAMIC RELATED ARTICLES SECTION -->
    {relatedDossiers.length > 0 && (
      <div class="pt-12 border-t border-[#E5E4DF]">
        <h3 class="font-serif text-2xl font-bold text-[#121212] mb-6">Continue Reading</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedDossiers.map(related => (
            <article class="border border-[#E5E4DF] p-6 hover:border-[#C5A059] transition-all bg-white flex flex-col justify-between">
              <div>
                {related.data.image && (
                  <a href={`/intelligence/${related.id}`} class="block mb-4 overflow-hidden bg-[#F4F3EF]">
                    <img 
                      src={related.data.image} 
                      alt={related.data.title} 
                      class="w-full aspect-[16/9] object-cover transition-transform duration-700 hover:scale-105" 
                      onerror="this.parentElement.style.display='none';"
                    />
                  </a>
                )}
                <span class="text-[10px] text-[#666666] uppercase tracking-wider block mb-2">{related.data.pillar[0]}</span>
                <h4 class="font-serif font-bold text-lg text-[#121212] leading-snug mb-3">
                  <a href={`/intelligence/${related.id}`} class="hover:text-[#C5A059] transition-colors">{related.data.title}</a>
                </h4>
              </div>
              <a href={`/intelligence/${related.id}`} class="text-xs font-bold text-[#C5A059] hover:text-[#07182D] uppercase tracking-widest flex items-center gap-1 mt-4">
                READ DOSSIER →
              </a>
            </article>
          ))}
        </div>
      </div>
    )}

  </main>

  <!-- SMART BACK BUTTON SCRIPT -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const backBtn = document.getElementById('back-btn');
      if (backBtn) {
        backBtn.addEventListener('click', (e) => {
          // Si el usuario navegó desde la misma web, retrocede preservando parámetros URL
          if (document.referrer.includes(window.location.host)) {
            e.preventDefault();
            window.history.back();
          }
        });
      }
    });
  </script>
</Layout>