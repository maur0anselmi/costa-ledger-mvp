---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allDossiers = await getCollection('intelligence');

// Ordenar dossiers por fecha de publicación descendente
const sortedDossiers = allDossiers.sort((a, b) => {
  const dateA = new Date(a.data.publishedDate).getTime();
  const dateB = new Date(b.data.publishedDate).getTime();
  return dateB - dateA;
});

const taxonomy = [
  {
    pillar: "PROPERTY & CAPITAL",
    subcategories: [
      "Property Markets & Developments",
      "Rentals & Income Property",
      "Mortgages, FX & Financing",
      "Business & Investment"
    ]
  },
  {
    pillar: "LEGAL, TAX & RESIDENCY",
    subcategories: [
      "Residency & Visa Pathways",
      "Cross-Border Tax",
      "Banking & Ownership Structures",
      "Estates & Succession"
    ]
  },
  {
    pillar: "LIFESTYLE & RELOCATION",
    subcategories: [
      "Schools & Family",
      "Healthcare & Wellness",
      "Golf, Yachting & Clubs",
      "Travel, Mobility & Access",
      "Food, Hospitality & Culture"
    ]
  }
];
---

<Layout title="Costa Ledger - Intelligence Vault">
  
  <!-- REGIONAL FILTER BAR -->
  <section class="bg-[#07182D] text-[#F9F9F6] py-2 border-b border-[#C5A059]/20">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 flex flex-wrap items-center justify-between gap-3 text-[11px]">
      <div class="flex items-center gap-2 font-bold tracking-widest uppercase text-slate-300">
        <span class="w-2 h-2 bg-[#C5A059]"></span>
        <span>FILTER BY REGION:</span>
      </div>
      <div class="flex flex-wrap gap-2 text-xs font-semibold tracking-wider uppercase">
        <button 
          data-region="all" 
          class="region-btn bg-[#C5A059] text-[#07182D] px-3 py-1 font-bold transition-all cursor-pointer"
        >
          ALL SOUTHERN EUROPE
        </button>
        <button 
          data-region="Costa del Sol" 
          class="region-btn border border-slate-700 text-slate-300 hover:border-[#C5A059] hover:text-white px-3 py-1 transition-all cursor-pointer"
        >
          COSTA DEL SOL
        </button>
        <button 
          data-region="Gibraltar" 
          class="region-btn border border-slate-700 text-slate-300 hover:border-[#C5A059] hover:text-white px-3 py-1 transition-all cursor-pointer"
        >
          GIBRALTAR
        </button>
        <button 
          data-region="Portugal" 
          class="region-btn border border-slate-700 text-slate-300 hover:border-[#C5A059] hover:text-white px-3 py-1 transition-all cursor-pointer"
        >
          PORTUGAL
        </button>
      </div>
    </div>
  </section>

  <!-- MAIN SPLIT VIEW CONTENT -->
  <main class="max-w-7xl mx-auto px-6 lg:px-12 py-12 flex-grow w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- LEFT SIDEBAR: COMPLETE TAXONOMY -->
      <aside class="lg:col-span-3 space-y-8">
        <div class="bg-[#F4F3EF] border border-[#E5E4DF] rounded-sm p-4 lg:p-0 lg:bg-transparent lg:border-none">
          <details id="intelligence-index-details" class="group">
            
            <!-- HEADER -->
            <summary class="flex items-center justify-between cursor-pointer select-none list-none">
              <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#666666] flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-[#C5A059] inline-block"></span>
                INTELLIGENCE INDEX
              </h3>
              <div class="flex items-center gap-3">
                <button id="reset-filters" class="hidden text-[10px] text-[#C5A059] hover:underline font-bold uppercase cursor-pointer">RESET FILTERS</button>
                <span class="text-xs text-[#C5A059] transition-transform duration-200 group-open:rotate-180">▼</span>
              </div>
            </summary>
            
            <!-- INTERACTIVE TAXONOMY LIST -->
            <div class="mt-4 pt-4 border-t border-[#E5E4DF] lg:border-t-0 lg:pt-2 lg:mt-4">
              {taxonomy.map(section => (
                <div class="mb-6">
                  <!-- PILLAR BUTTON -->
                  <button 
                    data-pillar={section.pillar}
                    class="pillar-btn font-serif font-bold text-base text-[#121212] hover:text-[#C5A059] transition-colors block text-left mb-2 cursor-pointer w-full"
                  >
                    {section.pillar}
                  </button>
                  <ul class="space-y-1.5 text-xs text-[#2A2E33] border-l border-[#E5E4DF] pl-3">
                    {section.subcategories.map(sub => (
                      <li>
                        <!-- SUBCATEGORY BUTTON -->
                        <button 
                          data-sub={sub} 
                          data-pillar-parent={section.pillar}
                          class="sub-btn text-left hover:text-[#C5A059] transition-colors block cursor-pointer w-full py-0.5"
                        >
                          {sub}
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

          </details>
        </div>

        <!-- SIDEBAR LEAD MAGNET -->
        <div class="hidden lg:block bg-[#07182D] p-6 text-[#F9F9F6] space-y-3 border-l-2 border-[#C5A059]">
          <span class="text-[9px] font-bold tracking-[0.2em] text-[#C5A059] uppercase block">EXECUTIVE DOWNLOAD</span>
          <h4 class="font-serif text-lg font-bold text-white">2026–2027 Southern Europe Report</h4>
          <p class="text-[11px] text-gray-300">Get the complete digital PDF dispatched to your inbox.</p>
          <a href="/report" class="block text-center bg-[#C5A059] hover:bg-[#B28E46] text-[#07182D] text-[10px] uppercase font-bold tracking-widest py-2.5 font-bold transition-colors">REQUEST REPORT</a>
        </div>
      </aside>

      <!-- RIGHT PANEL -->
      <section class="lg:col-span-9 space-y-8">
        
        <!-- KEY METRICS BANNER -->
        <div class="bg-white border border-[#E5E4DF] p-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div>
            <span class="text-[10px] tracking-widest text-[#666666] uppercase block">SPAIN — BECKHAM LAW</span>
            <span class="font-serif text-xl font-bold text-[#121212]">24% Flat Rate</span>
          </div>
          <div>
            <span class="text-[10px] tracking-widest text-[#666666] uppercase block">ANDALUCIA — WEALTH TAX</span>
            <span class="font-serif text-xl font-bold text-[#C5A059]">100% Exemption</span>
          </div>
          <div>
            <span class="text-[10px] tracking-widest text-[#666666] uppercase block">GIBRALTAR — CAT 2 STATUS</span>
            <span class="font-serif text-xl font-bold text-[#121212]">£44,700 Max Tax</span>
          </div>
          <div>
            <span class="text-[10px] tracking-widest text-[#666666] uppercase block">PORTUGAL — IFICI / NHR 2.0</span>
            <span class="font-serif text-xl font-bold text-[#121212]">20% Flat Rate</span>
          </div>
        </div>

        <!-- UNIFIED DOSSIERS GRID (Added items-start to fix stretching) -->
        <div id="dossiers-container" class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
          {sortedDossiers.map((dossier, index) => (
            <article 
              class={`dossier-card bg-white transition-all shadow-sm flex flex-col justify-between ${
                index === 0 
                  ? 'md:col-span-2 border-2 border-[#C5A059] p-6 md:p-8' 
                  : 'col-span-1 border border-[#E5E4DF] p-6 hover:border-[#C5A059]'
              }`}
              data-regions={JSON.stringify(dossier.data.region)}
              data-subs={JSON.stringify(dossier.data.subcategory)}
              data-pillars={JSON.stringify(dossier.data.pillar)}
            >
              <div>
                {dossier.data.image && (
                  <a 
                    href={`/intelligence/${dossier.id}`} 
                    class={`card-image-wrapper block mb-5 overflow-hidden bg-[#F4F3EF] border border-[#E5E4DF] ${index === 0 ? 'hidden' : ''}`}
                  >
                    <img 
                      src={dossier.data.image} 
                      alt={dossier.data.title} 
                      class="w-full aspect-[16/9] object-cover transition-transform duration-700 hover:scale-105"
                      onerror="this.parentElement.style.display='none';"
                    />
                  </a>
                )}
                
                <div class="flex items-center justify-between mb-3">
                  <span class="bg-[#C5A059] text-[#07182D] text-[9px] font-bold tracking-widest uppercase px-2.5 py-1">
                    {dossier.data.badgeType}
                  </span>
                  <span class="text-[11px] text-[#666666]">
                    {new Date(dossier.data.publishedDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })} • {dossier.data.region.join(' & ')}
                  </span>
                </div>

                <h2 class={`card-title font-serif font-bold text-[#121212] mb-3 leading-snug ${index === 0 ? 'text-2xl md:text-3xl' : 'text-lg md:text-xl'}`}>
                  <a href={`/intelligence/${dossier.id}`} class="hover:text-[#C5A059] transition-colors">
                    {dossier.data.title}
                  </a>
                </h2>

                <p class={`card-summary text-xs md:text-sm text-[#2A2E33] leading-relaxed mb-6 ${index === 0 ? '' : 'line-clamp-3'}`}>
                  {dossier.data.summary}
                </p>
              </div>

              <div class="flex items-center justify-between border-t border-[#E5E4DF] pt-4 mt-auto">
                <span class="text-[11px] font-semibold text-[#121212] uppercase tracking-wider">
                  {dossier.data.pillar.join(' & ')} / {dossier.data.subcategory.join(' & ')}
                </span>
                <a href={`/intelligence/${dossier.id}`} class="text-xs font-bold text-[#C5A059] hover:text-[#07182D] uppercase tracking-widest flex items-center gap-1">
                  READ DOSSIER →
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- PAGINATION CONTROLS -->
        <div id="pagination-controls" class="flex flex-wrap justify-center items-center gap-2 mt-12 hidden">
          <!-- Buttons dynamically injected via JS -->
        </div>

        <!-- PENDING VERIFICATION STATE -->
        <div id="verification-state" class="hidden bg-white border-l-4 border-[#07182D] border-y border-r border-[#E5E4DF] p-8 md:p-12 shadow-sm">
          <div class="flex items-center justify-between mb-4">
            <span class="bg-[#07182D] text-[#F9F9F6] text-[9px] font-bold tracking-[0.2em] uppercase px-2.5 py-1 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#C5A059] animate-pulse"></span>
              VERIFICATION IN PROGRESS
            </span>
            <span class="text-[11px] text-[#666666] font-mono">CODE: CL-AUDIT-2026</span>
          </div>
          <h3 class="font-serif text-2xl md:text-3xl font-bold text-[#121212] mb-3">
            Dossier Under Institutional Compliance Review
          </h3>
          <p class="text-xs md:text-sm text-[#2A2E33] leading-relaxed mb-6 max-w-2xl">
            Our legal and market intelligence desk is currently validating cross-border tax implications and primary asset source data for <strong id="active-filter-label" class="text-[#07182D] font-bold">this section</strong>. To preserve institutional accuracy for HNWI clients, unverified figures remain restricted from public indexing.
          </p>
          <div class="pt-6 border-t border-[#E5E4DF] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="text-[11px] text-[#666666]">
              <span class="font-bold text-[#121212] uppercase">Estimated Release:</span> Pending Desk Sign-off
            </div>
            <a href="/join" class="inline-flex items-center gap-2 bg-[#C5A059] hover:bg-[#B28E46] text-white text-xs uppercase font-bold tracking-widest px-6 py-3 transition-colors font-bold">
              <span>REQUEST DIRECT DESK BRIEFING</span>
              <span>→</span>
            </a>
          </div>
        </div>

      </section>

    </div>
  </main>

  <!-- DYNAMIC FILTER, PAGINATION & URL SYNC SCRIPT -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const indexDetails = document.getElementById('intelligence-index-details');
      if (indexDetails && window.innerWidth >= 1024) {
        indexDetails.open = true;
      }

      // Parámetros de URL
      const urlParams = new URLSearchParams(window.location.search);
      let selectedRegion = urlParams.get('region') || 'all';
      let selectedPillar = urlParams.get('pillar') || null;
      let selectedSub = urlParams.get('sub') || null;
      
      // Variables de Paginación
      let currentPage = 1;
      const itemsPerPage = 9; // 1 Hero + 8 Tarjetas = 9 por página (5 filas en la pág. 1)

      const regionBtns = document.querySelectorAll('.region-btn');
      const pillarBtns = document.querySelectorAll('.pillar-btn');
      const subBtns = document.querySelectorAll('.sub-btn');
      const cards = document.querySelectorAll('.dossier-card');
      const verificationState = document.getElementById('verification-state');
      const activeFilterLabel = document.getElementById('active-filter-label');
      const resetBtn = document.getElementById('reset-filters');
      const paginationControls = document.getElementById('pagination-controls');

      function updateURL() {
        const params = new URLSearchParams();
        if (selectedRegion && selectedRegion !== 'all') params.set('region', selectedRegion);
        if (selectedPillar) params.set('pillar', selectedPillar);
        if (selectedSub) params.set('sub', selectedSub);
        
        const newQuery = params.toString() ? '?' + params.toString() : window.location.pathname;
        history.pushState(null, '', newQuery);
      }

      function renderPagination(totalItems) {
        paginationControls.innerHTML = '';
        const totalPages = Math.ceil(totalItems / itemsPerPage);

        if (totalPages <= 1) {
          paginationControls.classList.add('hidden');
          return;
        }

        paginationControls.classList.remove('hidden');

        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.textContent = i;
          
          if (i === currentPage) {
            btn.className = "px-4 py-2 text-xs font-bold bg-[#C5A059] text-[#07182D] border border-[#C5A059]";
          } else {
            btn.className = "px-4 py-2 text-xs font-bold bg-white text-[#666666] border border-[#E5E4DF] hover:border-[#C5A059] hover:text-[#07182D] transition-colors";
          }
          
          btn.addEventListener('click', () => {
            currentPage = i;
            applyFilters();
            // Scroll suave hacia arriba cuando cambian de página
            window.scrollTo({
              top: document.getElementById('dossiers-container').offsetTop - 50,
              behavior: 'smooth'
            });
          });
          
          paginationControls.appendChild(btn);
        }
      }

      function applyFilters() {
        // Estilos de región
        regionBtns.forEach(btn => {
          const r = btn.getAttribute('data-region');
          if (r.toLowerCase() === selectedRegion.toLowerCase()) {
            btn.classList.add('bg-[#C5A059]', 'text-[#07182D]', 'font-bold');
            btn.classList.remove('border', 'border-slate-700', 'text-slate-300');
          } else {
            btn.classList.remove('bg-[#C5A059]', 'text-[#07182D]', 'font-bold');
            btn.classList.add('border', 'border-slate-700', 'text-slate-300');
          }
        });

        // Estilos de pilar
        pillarBtns.forEach(btn => {
          const p = btn.getAttribute('data-pillar');
          if (selectedPillar && p.toLowerCase() === selectedPillar.toLowerCase()) {
            btn.classList.add('text-[#C5A059]');
            btn.classList.remove('text-[#121212]');
          } else {
            btn.classList.remove('text-[#C5A059]');
            btn.classList.add('text-[#121212]');
          }
        });

        // Estilos de subcategoría
        subBtns.forEach(btn => {
          const s = btn.getAttribute('data-sub');
          if (selectedSub && s.toLowerCase() === selectedSub.toLowerCase()) {
            btn.classList.add('text-[#C5A059]', 'font-bold');
          } else {
            btn.classList.remove('text-[#C5A059]', 'font-bold');
          }
        });

        // Filtrar todas las tarjetas en memoria
        let visibleCards = [];
        cards.forEach(card => {
          const cardRegions = JSON.parse(card.getAttribute('data-regions') || '[]');
          const cardPillars = JSON.parse(card.getAttribute('data-pillars') || '[]');
          const cardSubs = JSON.parse(card.getAttribute('data-subs') || '[]');

          const matchesRegion = (selectedRegion === 'all' || cardRegions.some(r => r.toLowerCase() === selectedRegion.toLowerCase()));
          const matchesPillar = (!selectedPillar || cardPillars.some(p => p.toLowerCase() === selectedPillar.toLowerCase()));
          const matchesSub = (!selectedSub || cardSubs.some(s => s.toLowerCase() === selectedSub.toLowerCase()));

          if (matchesRegion && matchesPillar && matchesSub) {
            visibleCards.push(card);
          }
          // Ocultamos todas por ahora
          card.classList.add('hidden');
        });

        // Aplicar la lógica de paginación
        const totalPages = Math.ceil(visibleCards.length / itemsPerPage);
        if (currentPage > totalPages && totalPages > 0) {
          currentPage = totalPages;
        }

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const paginatedCards = visibleCards.slice(startIndex, endIndex);

        // Renderizar las tarjetas de la página actual
        paginatedCards.forEach((card, index) => {
          card.classList.remove('hidden');
          
          // Formato estándar para todas las tarjetas
          card.classList.remove('md:col-span-2', 'border-2', 'border-[#C5A059]', 'p-8');
          card.classList.add('col-span-1', 'border', 'border-[#E5E4DF]', 'p-6');
          
          const title = card.querySelector('.card-title');
          if (title) {
            title.classList.remove('text-2xl', 'md:text-3xl');
            title.classList.add('text-lg', 'md:text-xl');
          }
          
          const summary = card.querySelector('.card-summary');
          if (summary) {
            summary.classList.add('line-clamp-3');
          }

          const imageWrapper = card.querySelector('.card-image-wrapper');
          if (imageWrapper) {
            imageWrapper.classList.remove('hidden');
          }
        });

        // Si estamos en la página 1, la primera tarjeta asume el rol de Hero
        if (currentPage === 1 && paginatedCards.length > 0) {
          const heroCard = paginatedCards[0];
          heroCard.classList.remove('col-span-1', 'border-[#E5E4DF]', 'p-6');
          heroCard.classList.add('md:col-span-2', 'border-2', 'border-[#C5A059]', 'p-8');
          
          const title = heroCard.querySelector('.card-title');
          if (title) {
            title.classList.remove('text-lg', 'md:text-xl');
            title.classList.add('text-2xl', 'md:text-3xl');
          }
          
          const summary = heroCard.querySelector('.card-summary');
          if (summary) {
            summary.classList.remove('line-clamp-3');
          }

          const imageWrapper = heroCard.querySelector('.card-image-wrapper');
          if (imageWrapper) {
            imageWrapper.classList.add('hidden');
          }
        }

        // Mostrar estado de verificación si no hay resultados
        if (visibleCards.length === 0) {
          verificationState.classList.remove('hidden');
          const filterLabels = [];
          if (selectedRegion !== 'all') filterLabels.push(`Region: ${selectedRegion}`);
          if (selectedPillar) filterLabels.push(`Pillar: ${selectedPillar}`);
          if (selectedSub) filterLabels.push(`Subcategory: ${selectedSub}`);
          activeFilterLabel.textContent = filterLabels.join(' | ') || 'selected query';
        } else {
          verificationState.classList.add('hidden');
        }

        // Mostrar u ocultar el botón Reset
        if (selectedRegion !== 'all' || selectedPillar !== null || selectedSub !== null) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }

        // Actualizar la botonera de paginación
        renderPagination(visibleCards.length);
      }

      function filterContent() {
        currentPage = 1; // Volver a la pág 1 siempre que se aplique un filtro nuevo
        updateURL();
        applyFilters();
      }

      // Event Handlers
      regionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          selectedRegion = btn.getAttribute('data-region');
          filterContent();
        });
      });

      pillarBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const pillar = btn.getAttribute('data-pillar');
          if (selectedPillar === pillar) {
            selectedPillar = null;
          } else {
            selectedPillar = pillar;
            selectedSub = null;
          }
          filterContent();
        });
      });

      subBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const sub = btn.getAttribute('data-sub');
          const parentPillar = btn.getAttribute('data-pillar-parent');
          if (selectedSub === sub) {
            selectedSub = null;
          } else {
            selectedSub = sub;
            if (parentPillar) selectedPillar = parentPillar;
          }
          filterContent();
        });
      });

      resetBtn.addEventListener('click', () => {
        selectedRegion = 'all';
        selectedPillar = null;
        selectedSub = null;
        filterContent();
      });

      window.addEventListener('popstate', () => {
        const params = new URLSearchParams(window.location.search);
        selectedRegion = params.get('region') || 'all';
        selectedPillar = params.get('pillar') || null;
        selectedSub = params.get('sub') || null;
        currentPage = 1; // Volver a pág 1 al navegar por historial
        applyFilters();
      });

      // Ejecución inicial
      applyFilters();
    });
  </script>
</Layout>