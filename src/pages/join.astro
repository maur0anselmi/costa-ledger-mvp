---
import Layout from '../layouts/Layout.astro';
import BriefingForm from '../components/BriefingForm.astro';
---

<Layout title="Costa Ledger - The Briefing Access">
  <main class="flex-grow flex items-center py-12 lg:py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- LEFT COLUMN -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2">
          <span class="w-2 h-2 bg-[#C5A059]"></span>
          <span class="text-xs font-bold tracking-[0.25em] text-[#666666] uppercase">SOUTHERN EUROPE • PRIVATE MARKET RADAR</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl font-normal tracking-tight text-[#121212] leading-[1.08]">
          THE INSIGHTS YOU NEED BEFORE YOU MOVE OR INVEST.
        </h1>

        <p class="text-base text-[#2A2E33] font-normal leading-relaxed">
          Agile market alerts, regulatory commentary, and independent briefs on Southern Europe real estate, visas, and capital frameworks.
        </p>

        <div class="space-y-4 pt-6 border-t border-[#E5E4DF]">
          <div class="flex gap-4 items-start">
            <span class="text-[#C5A059] font-serif font-bold text-xl">01</span>
            <div>
              <strong class="block text-xs uppercase tracking-wider text-[#121212] font-bold mb-0.5">Market Radar</strong>
              <span class="text-xs text-[#666666] leading-relaxed">Prompt updates when visa requirements, tax policies, or mortgage rates shift.</span>
            </div>
          </div>
          
          <div class="flex gap-4 items-start">
            <span class="text-[#C5A059] font-serif font-bold text-xl">02</span>
            <div>
              <strong class="block text-xs uppercase tracking-wider text-[#121212] font-bold mb-0.5">Independent Analysis</strong>
              <span class="text-xs text-[#666666] leading-relaxed">Objective commentary on emerging developments across Southern Europe and Gibraltar.</span>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <span class="text-[#C5A059] font-serif font-bold text-xl">03</span>
            <div>
              <strong class="block text-xs uppercase tracking-wider text-[#121212] font-bold mb-0.5">Special Reports</strong>
              <span class="text-xs text-[#666666] leading-relaxed">Periodic deep-dive PDF guides for international relocation and property acquisitions.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: FORM -->
      <div class="lg:col-span-6">
        <BriefingForm 
          badgeText="FREE SUBSCRIBER ACCESS"
          title="JOIN THE BRIEFING"
          subtitle="Direct delivery. High signal, low frequency. Unsubscribe anytime."
          buttonText="SUBSCRIBE TO THE BRIEFING"
          loadingText="VERIFYING PROFILE..."
          source="join-page"
        />
      </div>

    </div>
  </main>
</Layout>