---
import Layout from '../layouts/Layout.astro';
import BriefingForm from '../components/BriefingForm.astro';
---

<Layout 
  title="Costa Ledger - 2026–2027 Southern Europe Intelligence Outlook" 
  minimalHeader={true} 
  headerLabel="SPECIAL PREMIUM REPORT ACCESS"
>
  <main class="flex-grow flex items-center py-12 lg:py-20">
    <div class="max-w-6xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- LEFT COLUMN -->
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2">
          <span class="w-2 h-2 bg-[#C5A059]"></span>
          <span class="text-xs font-bold tracking-[0.25em] text-[#666666] uppercase">SPECIAL PREMIUM REPORT • 2026–2027 EDITION</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl font-normal tracking-tight text-[#121212] leading-[1.08]">
          SOUTHERN EUROPE INTELLIGENCE OUTLOOK 2026–2027.
        </h1>

        <p class="text-base text-[#2A2E33] font-normal leading-relaxed">
          Costa Ledger has prepared an essential intelligence report designed specifically for individuals, families, and investors considering a move or capital allocation in Southern Europe.
        </p>

        <!-- PDF VISUAL CARD (AZUL MARINO #07182D) -->
        <div class="bg-[#07182D] text-[#F9F9F6] p-6 border-l-4 border-[#C5A059] flex items-center gap-6 my-6 shadow-xl">
          <div class="w-20 h-28 bg-[#0B223D] border border-slate-700 p-2.5 flex flex-col justify-between shrink-0 shadow-lg relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-tr from-[#C5A059]/20 to-transparent opacity-50"></div>
            <span class="text-[6px] tracking-widest text-[#C5A059] uppercase font-bold z-10">COSTA LEDGER</span>
            <span class="font-serif text-[10px] text-white leading-tight font-bold z-10">OUTLOOK<br>2026–2027</span>
            <span class="text-[5px] tracking-wider text-gray-400 uppercase z-10">CONFIDENTIAL</span>
          </div>
          <div>
            <span class="text-[10px] font-bold tracking-[0.2em] text-[#C5A059] uppercase block mb-1">EXECUTIVE BRIEFING PDF</span>
            <h4 class="font-serif text-xl text-white font-semibold">2026–2027 Southern Europe Intelligence Outlook</h4>
            <span class="text-xs text-gray-300 mt-1 block">Comprehensive Analysis • Digital PDF • Instant Email Delivery</span>
          </div>
        </div>

        <!-- CORE TOPICS -->
        <div class="space-y-3 pt-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#121212]">Core Topics Covered in This Report:</h3>
          <ul class="space-y-2.5 text-xs text-[#2A2E33]">
            <li class="flex items-start gap-2.5">
              <span class="text-[#C5A059] font-bold text-sm leading-none">•</span>
              <span><strong>Real Estate Overview:</strong> High-level yield trends, market dynamics, and regional valuation benchmarks.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#C5A059] font-bold text-sm leading-none">•</span>
              <span><strong>Residency & Tax Frameworks:</strong> Essential guidance on active visas, tax incentives, and legal entry routes.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#C5A059] font-bold text-sm leading-none">•</span>
              <span><strong>Financing & Capital Structuring:</strong> Insights on mortgage accessibility and private banking protocols for non-residents.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-[#C5A059] font-bold text-sm leading-none">•</span>
              <span><strong>Lifestyle & Relocation Essentials:</strong> Key logistics for international schooling, healthcare, and daily living.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- RIGHT COLUMN: FORM -->
      <div class="lg:col-span-6">
        <BriefingForm 
          badgeText="COMPLIMENTARY ACCESS"
          title="REQUEST THE REPORT"
          subtitle="Complete the form below to receive your digital copy via email."
          buttonText="ACCESS THE REPORT"
          loadingText="DISPATCHING REPORT..."
          showCheckboxes={true}
          source="report-page"
          modalBadge="PDF REPORT DISPATCHED"
          modalMessage="We have transmitted the 2026–2027 Southern Europe Intelligence Outlook PDF report to your inbox. Please check your email to download your copy."
        />
      </div>

    </div>
  </main>
</Layout>